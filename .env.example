# مفتاح Google Gemini (اختياري): بدونه يعمل التطبيق بالمحرك المحلي
# احصل عليه من https://aistudio.google.com/apikey
GEMINI_API_KEY=

# النموذج المستخدم (يمكن تغييره دون تعديل الكود)
GEMINI_MODEL=gemini-3.8-flash

# ── الحسابات (حساب إدارة + حساب ديمو) ──
# مفتاح توقيع الجلسات — إلزامي في الإنتاج (32 حرفاً عشوائياً على الأقل): openssl rand -base64 32
AUTH_SECRET=
# حساب الإدارة — في الإنتاج لا يعمل إلا إذا ضبطت ADMIN_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# حساب الديمو — يظهر في صفحة الدخول للتجربة (بدون استهلاك الذكاء المدفوع)
DEMO_ENABLED=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234
